grain-peak.47.236.76.214.nip.io {
	encode zstd gzip
	@document path /
	header @document Cache-Control "no-cache"
	@versionedAssets path_regexp versionedAssets \.(css|js)$
	header @versionedAssets Cache-Control "public, max-age=31536000, immutable"
	request_body {
		max_size 15MB
	}
	reverse_proxy 127.0.0.1:8772
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

uv-spectrum.47.236.76.214.nip.io {
	encode zstd gzip
	@document path /
	header @document Cache-Control "no-cache"
	@versionedAssets path_regexp versionedAssets \.(css|js)$
	header @versionedAssets Cache-Control "public, max-age=31536000, immutable"
	root * /opt/uv-spectrum/current/web
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

