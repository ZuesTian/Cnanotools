(portal_static_health) {
	@health path /health
	header @health {
		Access-Control-Allow-Origin https://zuestian.github.io
		Content-Type application/json
		Cache-Control no-store
	}
}

grain-peak.47.236.76.214.nip.io {
	encode zstd gzip
	@document path /
	header @document Cache-Control "no-cache"
	@assets path *.css *.js *.mjs
	header @assets Cache-Control "no-cache"
	request_body {
		max_size 15MB
	}
	reverse_proxy 127.0.0.1:8772
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

uv-spectrum.47.236.76.214.nip.io {
	encode zstd gzip
	@document path /
	header @document Cache-Control "no-cache"
	@assets path *.css *.js *.mjs
	header @assets Cache-Control "no-cache"
	import portal_static_health
	root * /opt/uv-spectrum/current/web
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

raman.47.236.76.214.nip.io {
	encode zstd gzip
	@document path /
	header @document Cache-Control "no-cache"
	@assets path *.css *.js *.mjs
	header @assets Cache-Control "no-cache"
	request_body {
		max_size 26MB
	}
	reverse_proxy 127.0.0.1:8771
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

cnt-xrd.47.236.76.214.nip.io {
	encode zstd gzip
	import portal_static_health
	root * {$CNT_XRD_ROOT:/opt/cnt-xrd/current}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	@private not path / /index.html /CNT-XRD.html /health
	rewrite /index.html /CNT-XRD.html
	respond @private 404
	file_server {
		index CNT-XRD.html
	}
}

sim-db.47.236.76.214.nip.io {
	encode zstd gzip
	import portal_static_health
	root * {$SIM_DB_ROOT:/opt/sim-db/current}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	@archive path /oc-furnace-report-plain-v6/*
	handle @archive {
		root * {$SIM_DB_ARCHIVE_ROOT:/opt/cnt-bet/public}
		file_server
	}
	handle {
		file_server
	}
}
